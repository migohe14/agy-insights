  "license": "MIT",
  "keywords": [
    "antigravity",
    "agy",
    "gemini",
    "tokens",
    "context",
    "cli",
    "token-usage",
    "optimization",
    "i18n"
  ],
  "bin": {
    "agy-insights": "agy-insights.js"
  },
  "files": [
    "agy-insights.js",
    "lib/",
    "vendor/",
    "agy-insights.example.json",
    "docs/",
    "README.es.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node agy-insights.js",
    "test": "node --test test/agy-insights.test.js"
  },
  "author": "Miguel González",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/migohe14/agy-insights.git"
  },
  "homepage": "https://github.com/migohe14/agy-insights#readme",
  "bugs": {
    "url": "https://github.com/migohe14/agy-insights/issues"
  },
  "main": "agy-insights.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  }
}
